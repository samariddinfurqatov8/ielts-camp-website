# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="https://example.com"

# Database Configuration (PostgreSQL URL)
# Agar PostgreSQL ulanishi berilsa, ushbu bazadan foydalaniladi.
# Bo'sh qoldirilsa, avtomatik ravishda xavfsiz va doimiy ./data/ielts_camp.db (SQLite) ishlatiladi.
# Misol: postgresql://postgres:password@localhost:5432/ielts_camp
