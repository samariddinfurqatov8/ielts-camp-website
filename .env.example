# Administrator Auth
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMeInProduction123!"
JWT_SECRET="super-secret-jwt-key-for-ielts-camp-2026"

# Telegram Bot Notification Integration
# @BotFather orqali olingan bot tokeni
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Bildirishnomalar borishi kerak bo'lgan Telegram guruh yoki admin chat_id raqami
TELEGRAM_CHAT_ID="-1001234567890"
